---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route, type Locale } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
import { helpers } from '../../lib/helpers';
import { EMBED } from '../../lib/embed';
interface Props { lang: Locale }
const { lang } = Astro.props;
const H = helpers(lang); const T = H.T;
const e = EMBED[lang];
const code = `<iframe src="${SITE_URL}/embed/${e.slug}/" title="${e.title}" width="100%" height="1250" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
const title = T('Maut- und Vignettenrechner auf Ihrer Seite einbinden', 'Embed the toll and vignette calculator on your site', 'De tol- en vignetcalculator op uw site insluiten');
const description = T(
  'Binden Sie den Rechner für Maut, Vignetten und Sprit der Urlaubsfahrt kostenlos als iframe ein: ein Code zum Kopieren, ohne Anmeldung, ohne Cookie, immer aktuell.',
  'Embed the calculator for the tolls, vignettes and fuel of a holiday drive free of charge as an iframe: one code to copy, no sign-up, no cookie, always up to date.',
  'Sluit de rekenhulp voor tol, vignetten en brandstof van de vakantierit gratis in als iframe: één code om te kopiëren, zonder registratie, zonder cookie, altijd actueel.');
const crumb = T('Rechner einbinden', 'Embed the calculator', 'Rekenhulp insluiten');
---
<PageLayout title={title} description={description} lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: T('Startseite', 'Home', 'Home'), path: route('home', lang) }, { name: crumb, path: route('widget', lang) }])]} breadcrumbs={[{ label: crumb }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{crumb}</h1>
    <p class="mt-3 text-lg text-navy-700">{T('Ein Code zum Kopieren, ohne Anmeldung und ohne Kosten. Campingplätze, Automobilclubs, Vereine und Redaktionen bauen ihn in einer Minute ein.', 'One code to copy, no sign-up and no fee. Campsites, motoring clubs, associations and newsrooms set it up in a minute.', 'Eén code om te kopiëren, zonder registratie of kosten. Campings, automobielclubs, verenigingen en redacties plaatsen hem in een minuut.')}</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>{T('Bedingungen: der Link unter dem Rechner bleibt sichtbar, der Inhalt wird nicht verändert, er wird ohne Gewähr bereitgestellt. Wenn wir Tarife oder Spritpreise aktualisieren, ist Ihre Seite ohne Ihr Zutun auf dem neuen Stand.', 'Terms: the link under the calculator stays visible, the content is not altered, and it is provided without warranty. When we update rates or fuel prices, your page is up to date without you doing anything.', 'Voorwaarden: de link onder de rekenhulp blijft zichtbaar, de inhoud wordt niet gewijzigd, hij wordt zonder garantie aangeboden. Als wij tarieven of brandstofprijzen bijwerken, is uw pagina zonder uw toedoen bij.')}</p>
    <p>{T('Andere Sprachen:', 'Other languages:', 'Andere talen:')} {Object.values(EMBED).filter((x) => x.slug !== e.slug).map((x, i) => <>{i > 0 && ' · '}<code>{`${SITE_URL}/embed/${x.slug}/`}</code></>)}</p>
    <p>{T('Was Ihre Besucher eingeben, bleibt in ihrem Browser, und der eingebettete Rahmen setzt kein Cookie. Fragen über die', 'What your visitors enter stays in their browser and the embedded frame sets no cookie. Questions via the', 'Wat uw bezoekers invullen blijft in hun browser en het ingesloten kader plaatst geen cookie. Vragen via de')} <a href={route('contact', lang)}>{T('Kontaktseite', 'contact page', 'contactpagina')}</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${e.slug}/`} title={e.title} width="100%" height="1250" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
